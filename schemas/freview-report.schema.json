{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raiseCatError/freview/blob/main/schemas/freview-report.schema.json",
  "title": "freview report format v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "report_kind",
    "timestamp_utc",
    "mode_requested",
    "scope",
    "repository",
    "findings",
    "not_observed"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "string"
    },
    "report_kind": {
      "enum": [
        "local-snapshot",
        "partial-audit",
        "full-audit"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "mode_requested": {
      "enum": [
        "quick",
        "standard",
        "full",
        "targeted"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "included",
        "excluded"
      ],
      "additionalProperties": false,
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specialists": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "summary",
          "status",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "informational"
            ]
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string"
          },
          "remediation": {
            "type": "object",
            "description": "Non-executed practical repair plan, based on evidence. Required for confirmed actionable agent findings.",
            "additionalProperties": false,
            "required": [
              "summary",
              "steps",
              "verification",
              "confidence"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "verification": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prerequisites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "estimated_effort": {
                "enum": [
                  "small",
                  "medium",
                  "large",
                  "unknown"
                ]
              },
              "requires_approval": {
                "type": "boolean",
                "const": true
              }
            }
          }
        }
      }
    },
    "not_observed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_snapshot": {
      "type": "object",
      "description": "Optional detailed local metadata. No inference about remote state.",
      "additionalProperties": true
    },
    "human_review_required": {
      "type": "boolean"
    },
    "reference_report": {
      "type": [
        "string",
        "null"
      ]
    },
    "duplicate_clusters": {
      "type": "array",
      "description": "Only work-item/plan/PR/doc delivery duplicates, never code clones. Candidates are not confirmed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_urls",
          "status",
          "reason",
          "evidence"
        ],
        "properties": {
          "item_urls": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "candidate",
              "related",
              "not-duplicate"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canonical_recommendation": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
    "remediation_plan": {
      "type": "array",
      "description": "Dependency-ordered, approval-required proposed repairs; never performed by freview",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_ids",
          "action",
          "priority",
          "verification",
          "requires_approval"
        ],
        "properties": {
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "informational"
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "requires_approval": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "implementation_suggestions_requested": {
      "type": "boolean",
      "description": "Explicit opt-in only for future or never-implemented features"
    },
    "verification_manifest": {
      "type": "array",
      "description": "Category-level execution evidence: what was actually checked, tool/source and exact ref. Cannot equate a selected category with completed verification.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "status",
          "evidence"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "partial",
              "not-observed",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ref_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "report_kind": {
            "enum": [
              "partial-audit",
              "full-audit"
            ]
          }
        },
        "required": [
          "report_kind"
        ]
      },
      "then": {
        "required": [
          "remediation_plan",
          "duplicate_clusters",
          "verification_manifest"
        ]
      }
    }
  ]
}
